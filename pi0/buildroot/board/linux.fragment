# Kernel config fragment applied on top of the Raspberry Pi bcmrpi
# defconfig.  Two ideas:
#
# 1. No loadable modules.  bcmrpi builds hundreds of =m drivers; with
#    modules enabled they would all be installed into the squashfs and
#    triple its size for hardware this board does not have.  Disabling
#    CONFIG_MODULES drops all of them at once, and everything the board
#    *does* need is forced =y below — a read-only rootfs also gets
#    simpler when nothing ever needs to be loaded at runtime.
# 2. Build in exactly what the bench lab needs: squashfs(zstd) root,
#    overlayfs for /etc and /var, f2fs for the data partition, zram
#    swap, and the dwc2 USB gadget stack (ECM + ACM + RNDIS).
# CONFIG_MODULES is not set

# Root filesystem (squashfs, zstd — matches BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD)
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y

# Writable /etc and /var on tmpfs (see /sbin/preinit in the overlay)
CONFIG_OVERLAY_FS=y

# Data partition.  f2fs is log-structured — friendlier to SD card
# flash translation layers than ext4's journal, which matters when the
# workload is an IBD hammering the disk for days.
CONFIG_F2FS_FS=y

# Boot/"mailbox" partition (FAT32, edited from any OS)
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# zram swap: memory peaks during IBD on 512 MB need headroom, and
# compressed RAM beats swapping onto the SD card in both speed and
# card lifetime.
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_CRYPTO_LZO=y

# USB gadget: dwc2 in peripheral mode + configfs-composed functions.
# ECM (ethernet, works out of the box on Linux/macOS hosts), ACM
# (serial console), RNDIS (opt-in ethernet for Windows hosts).
# All =y — with modules disabled there is nothing to load.
CONFIG_USB_DWC2=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y

# florestad may open v6 sockets; bcmrpi has IPv6 as a module, which
# CONFIG_MODULES=n would silently drop — force it in.
CONFIG_IPV6=y
