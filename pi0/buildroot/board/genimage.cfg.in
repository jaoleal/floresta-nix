# genimage template for the Floresta Pi Zero SD image.
# #BOOT_FILES# is filled in by post-image.sh with everything the
# firmware and the lab need on the FAT partition.
#
# Only two partitions are in the flashed image:
#   p1  FAT32 128M  /boot — firmware, kernel, florestaos.conf, results/
#   p2  squashfs    /     — immutable rootfs
# The f2fs /data partition (p3) is created on first boot, so the image
# stays small and the partition fills whatever card it lands on.

image boot.vfat {
	vfat {
		label = "FLORESTA"
		files = {
#BOOT_FILES#
		}
	}

	# 128 MB: room for firmware + kernel (~15 MB) and months of CSV
	# results in the mailbox without ever thinking about it again.
	size = 128M
}

image sdcard.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs {
		partition-type = 0x83
		image = "rootfs.squashfs"
		# Fixed 64M (padded) so the end of p2 — and therefore the
		# first-boot start sector of p3 — is identical on every
		# build, keeping images comparable across revisions.
		size = 64M
	}
}
